    {
      "id": "getty",
      "name": "Getty Provenance Index",
      "kind": "Cached lookup",
      "role": "suggestions",
      "description": "Dealer stock books and sales catalogs, searched ahead of time for the names in a gap. It only produces leads: suggestions that a person can accept to close a gap. It never adds events to a chain.",
      "endpoint": "https://data.getty.edu/provenance/sparql",
      "license": "See Getty's terms of use",
      "retrievedAt": "2026-10-29T23:38:32Z",
      "lookups": [
        {
          "name": "Boussod",
          "query": "PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nSELECT DISTINCT ?party ?party_label ?acquisition ?label WHERE {\n  ?party a ?kind ; rdfs:label ?party_label .\n  FILTER(?kind IN (crm:E21_Person, crm:E74_Group))\n  FILTER(CONTAINS(LCASE(STR(?party_label)), \"boussod\"))\n  ?acquisition (crm:P22_transferred_title_to|crm:P23_transferred_title_from) ?party ;\n               a crm:E8_Acquisition ; rdfs:label ?label .\n} LIMIT 25",
          "endpoint": "https://data.getty.edu/provenance/sparql",
          "retrievedAt": "2026-10-29T23:38:32Z",
          "results": 2
        },
